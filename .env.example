# =========================================================
# AI StudyMate - Environment Variables Configuration
# =========================================================

# Google Gemini API Key (Recommended - Free from https://aistudio.google.com/)
# If not provided, AI StudyMate will automatically run in Smart Academic Engine Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Next Public key if you wish to expose directly in client
# NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
